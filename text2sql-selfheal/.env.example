# Configuration for Text-to-SQL Self-Healing System

# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_api_key_here

# Claude Model to use (optional, default: claude-sonnet-4-20250514)
MODEL=claude-sonnet-4-20250514

# Database path (optional, default: data/example.db)
DATABASE_PATH=data/example.db

# Schema file path (optional, default: data/schema.json)
SCHEMA_PATH=data/schema.json

# Maximum repair attempts (optional, default: 2)
MAX_RETRIES=2

# Confidence threshold for repairs (optional, default: 0.7)
CONFIDENCE_THRESHOLD=0.7

# Verbose output (optional, default: false)
VERBOSE=false
